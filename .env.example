# Variable names only — never put real values in this file.
# The app reads Plugged/backend/.env (create it yourself; agents are blocked
# from reading or writing .env files). Copy the lines you need and fill them in.

# Which AI answers the tutor: deepseek, gemini, claude (local Claude Code CLI),
# or fixture (replays recorded answers, no key, no cost).
AI_PROVIDER=

# DeepSeek (AI_PROVIDER=deepseek). Paid: top up at platform.deepseek.com first.
DEEPSEEK_API_KEY=
# Optional, default deepseek-flash
DEEPSEEK_MODEL=
# Optional, default 240000: one deadline (ms) for a whole ask, then /api/ask answers 504
DEEPSEEK_TIMEOUT_MS=
# Optional, default deepseek-v4-pro; empty turns it off. Asked once when the
# primary model times out, answers 5xx or can't be reached (never on a 4xx)
DEEPSEEK_FALLBACK_MODEL=
# Optional, default 25000: how long (ms) one primary request may take before
# the ask switches to the fallback model. Only with reasoning off
# (DEEPSEEK_THINKING=0); with it on, only an error switches (#4)
DEEPSEEK_PRIMARY_TIMEOUT_MS=
# Optional, on by default (empty is on): the model reasons before it builds
# (#205, #4). 0 (or off, false) turns it off: faster, no reasoning tokens billed.
DEEPSEEK_THINKING=
# Optional, with thinking on: sent as reasoning_effort (e.g. high)
DEEPSEEK_REASONING_EFFORT=
# Optional, with thinking on: max_tokens per request, default 32000
DEEPSEEK_MAX_TOKENS=

# Gemini (AI_PROVIDER=gemini). Free key at aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional, default gemini-flash-latest
GEMINI_MODEL=

# Photo → circuit (/api/photo). Readers tried in order, default gemini (alone,
# #172). gemini,deepseek adds deepseek-flash (no fallback model, it has no
# vision), asked only after Gemini fails with a 400/401/403, never after a
# timeout or Gemini's own retries. fixture replays recorded Readings only, no key, no cost.
PHOTO_PROVIDERS=
# The Gemini model for photos, default gemini-robotics-er-2-preview; uses
# GEMINI_API_KEY above. Pin a version, never a -latest alias
PHOTO_GEMINI_MODEL=
# Optional, default gemini-3.1-flash-lite: when the photo model above has no valid answer for the
# boxes by PHOTO_FALLBACK_AT_MS (or has used up its calls), the same request also goes to this model
# and the first valid answer wins. Boxes only, never the crops. Pin a version, never a -latest alias.
# Set but empty (PHOTO_FALLBACK_MODEL=) turns the fallback off
PHOTO_FALLBACK_MODEL=
# Optional, default 35000: ms into the box round before PHOTO_FALLBACK_MODEL is asked too
# (the survey takes 15-30 s; at 25 s the backup answered most busy boards)
PHOTO_FALLBACK_AT_MS=
# Optional, default 45000: one deadline (ms) for a whole photo, then /api/photo answers 504
PHOTO_TIMEOUT_MS=
# Set to 1 to save each Reading to Plugged/test/fixtures/photo/<key>.json for fixture replay
# (and each crop round's leads to Plugged/test/fixtures/photo/leads/<key>.json)
PHOTO_RECORD=
# Optional: default | minimal | low | medium | high. The Gemini thinking level on the photo boxes and crops
# (generationConfig.thinkingConfig.thinkingLevel); default or empty sends nothing (the model's own level)
PHOTO_THINKING=
# Optional: a Gemini call with no answer after this many ms gets one identical call alongside.
# Default 12000 for /api/photo/leads (crops), 25000 for the /api/photo survey (12 s resent and
# double-billed most surveys). When set, it applies to both
PHOTO_HEDGE_MS=
# Optional, default 40000: /api/photo/leads stops waiting after this many ms; crops still unanswered are AI_TIMEOUT (the confirm screen is already open by then, #173)
PHOTO_LEADS_TIMEOUT_MS=
# Optional, default 12: crops per batch call in /api/photo/leads
PHOTO_LEADS_BATCH=
# Optional, default 2: at most this many batch calls (12 crops each, PHOTO_LEADS_BATCH) in flight in /api/photo/leads, first calls and retries;
# the other batches wait their turn. A stall resend (PHOTO_HEDGE_MS) is exempt: it always goes out on time
PHOTO_LEADS_CONCURRENCY=

# Voice (/api/voice/stt and /api/voice/tts, #12): ElevenLabs speech behind the
# server. With no key, or VOICE_PROVIDER=off, /api/health says voice: off.
ELEVENLABS_API_KEY=
# Optional, default JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID=
# Optional, default scribe_v2
ELEVENLABS_STT_MODEL=
# Optional, default eleven_flash_v2_5
ELEVENLABS_TTS_MODEL=
# Optional: elevenlabs (the default when ELEVENLABS_API_KEY is set), off, or
# fixture (replays Plugged/test/fixtures/voice/, no key, no cost)
VOICE_PROVIDER=
# Optional, default 10000: one deadline (ms) per ElevenLabs call, then 504 VOICE_TIMEOUT
VOICE_TIMEOUT_MS=

# Server port, default 5001
PORT=
# Set to 1 only behind exactly one proxy (e.g. Render) so rate limits are per visitor
TRUST_PROXY=

# Sign-in and daily limits on the AI routes (deploy D3). All optional; local dev leaves them unset.
# Set to 1 so /api/ask, /api/photo and /api/photo/leads need a Google sign-in (Firebase ID token); unset is off
REQUIRE_AUTH=
# Optional, default plugged-hackathon: the Firebase project whose ID tokens are accepted
FIREBASE_PROJECT_ID=
# Optional, default 5: questions (/api/ask) per signed-in user per UTC day
ASK_PER_USER_DAY=
# Optional, default 1: photo reads (/api/photo) per signed-in user per UTC day (recorded sample photos are free)
PHOTO_PER_USER_DAY=
# Optional, default 100: questions per UTC day for all users together
ASK_GLOBAL_DAY=
# Optional, default 15: photo reads per UTC day for all users together
PHOTO_GLOBAL_DAY=
# Optional: Upstash Redis REST URL; with the token, the daily counts are shared by every server instance
UPSTASH_REDIS_REST_URL=
# Optional: its REST token. Without both (or when Upstash fails) each instance counts in memory
UPSTASH_REDIS_REST_TOKEN=
