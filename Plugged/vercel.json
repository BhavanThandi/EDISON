{
  "cleanUrls": false,
  "redirects": [
    { "source": "/", "destination": "/circuit3d/index.html?ui=edison", "permanent": false }
  ],
  "functions": {
    "api/[...path].js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
    }
  ]
}
